# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=troque-por-uma-sequencia-aleatoria-longa

# Login Google (OAuth 2.0, tipo aplicativo Web)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Somente desenvolvimento: permite o botão Entrar como teste
ALLOW_DEV_AUTH=true

# Supabase + backend Node persistente: copie a URI do Session Pooler (porta
# 5432) em Dashboard > Connect. Não monte o host manualmente.
# SUPABASE_DB_URL=postgresql://postgres.PROJETO:SENHA@aws-INDICE-REGIAO.pooler.supabase.com:5432/postgres
# Se a cadeia de certificados do provedor exigir, use false somente para Supabase.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Alternativa: PostgreSQL próprio. Sem banco configurado, desenvolvimento usa
# memória e perde os dados ao reiniciar. Produção exige uma das duas opções.
DATABASE_URL=postgresql://gog:gog@localhost:5432/gog_battle_royale

# Produção: caminho do build do cliente (o padrão já resolve apps/web/dist)
# WEB_DIST=/caminho/para/apps/web/dist
